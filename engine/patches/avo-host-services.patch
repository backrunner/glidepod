diff --git a/engine/hvf/vmm/src/bridge.rs b/engine/hvf/vmm/src/bridge.rs
new file mode 100644
index 0000000..a97728f
--- /dev/null
+++ b/engine/hvf/vmm/src/bridge.rs
@@ -0,0 +1,61 @@
+//! Bounded Ethernet bridge. A requested bridge never falls back to user-mode NAT.
+use crate::virtio::net::{Downlink, Uplink};
+use std::{collections::VecDeque, ffi::{CString, c_void}, sync::{Arc, Mutex}, thread};
+const MAX_FRAME: usize = 16384;
+const MAX_QUEUED: usize = 128;
+unsafe extern "C" {
+    fn gp_vmnet_open(interface: *const i8, mac: *mut u8, error: *mut i32) -> *mut c_void;
+    fn gp_vmnet_read(handle: *mut c_void, bytes: *mut u8, capacity: usize) -> i32;
+    fn gp_vmnet_write(handle: *mut c_void, bytes: *const u8, size: usize) -> i32;
+    fn gp_vmnet_wait(handle: *mut c_void);
+    fn gp_vmnet_wake(handle: *mut c_void);
+    fn gp_vmnet_close(handle: *mut c_void);
+}
+struct Shared { handle: *mut c_void, queue: Mutex<VecDeque<Vec<u8>>> }
+// Packet reads/writes are exclusive to the worker; wake is a thread-safe semaphore.
+unsafe impl Send for Shared {}
+unsafe impl Sync for Shared {}
+impl Drop for Shared { fn drop(&mut self) { unsafe { gp_vmnet_close(self.handle); } } }
+pub struct Bridge { shared: Arc<Shared>, pub mac: [u8; 6] }
+impl Bridge {
+    pub fn open(interface: &str) -> Result<Self, String> {
+        if interface.is_empty() || interface.len() > 15 || !interface.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_') {
+            return Err("Invalid bridge interface".into());
+        }
+        let name = CString::new(interface).unwrap();
+        let mut mac = [0; 6]; let mut error = 0;
+        let handle = unsafe { gp_vmnet_open(name.as_ptr(), mac.as_mut_ptr(), &mut error) };
+        if handle.is_null() { return Err(format!("Bridged networking could not start on {interface} (vmnet {error}). The engine needs macOS vmnet authorization and an available bridge interface. Shared networking was not substituted.")); }
+        Ok(Self { shared: Arc::new(Shared { handle, queue: Mutex::new(VecDeque::new()) }), mac })
+    }
+    pub fn connect(self, downlink: Downlink) -> Result<Uplink, String> {
+        let weak = Arc::downgrade(&self.shared);
+        thread::Builder::new().name("bridge-network".into()).spawn(move || {
+            let mut buffer = vec![0u8; MAX_FRAME];
+            while let Some(state) = weak.upgrade() {
+                unsafe { gp_vmnet_wait(state.handle); }
+                let outgoing: Vec<_> = state.queue.lock().unwrap().drain(..).collect();
+                for frame in outgoing { unsafe { gp_vmnet_write(state.handle, frame.as_ptr(), frame.len()); } }
+                for _ in 0..64 {
+                    let size = unsafe { gp_vmnet_read(state.handle, buffer.as_mut_ptr(), buffer.len()) };
+                    if size < 0 {
+                        // Losing a bridge must not leave Android reporting a healthy NAT link.
+                        eprintln!("Bridged network interface disconnected");
+                        std::process::exit(1);
+                    }
+                    if size == 0 { break; }
+                    if size as usize <= buffer.len() { downlink.deliver([buffer[..size as usize].to_vec()]); }
+                }
+            }
+        }).map_err(|e| e.to_string())?;
+        let shared = self.shared;
+        Ok(Box::new(move |frames| {
+            let mut queue = shared.queue.lock().unwrap();
+            for frame in frames {
+                if frame.len() >= 14 && frame.len() <= MAX_FRAME && queue.len() < MAX_QUEUED { queue.push_back(frame); }
+            }
+            drop(queue);
+            unsafe { gp_vmnet_wake(shared.handle); }
+        }))
+    }
+}
