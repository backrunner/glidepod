diff --git a/engine/hvf/vmm/src/vmnet.m b/engine/hvf/vmm/src/vmnet.m
new file mode 100644
index 0000000..0cc94cc
--- /dev/null
+++ b/engine/hvf/vmm/src/vmnet.m
@@ -0,0 +1,96 @@
+// Original GlidePod vmnet adapter. All packet I/O is owned by one Rust worker.
+#import <Foundation/Foundation.h>
+#import <vmnet/vmnet.h>
+#include <sys/uio.h>
+
+@interface GPVMNet : NSObject
+@property(nonatomic) interface_ref interface;
+@property(nonatomic, strong) dispatch_queue_t queue;
+@property(nonatomic, strong) dispatch_semaphore_t event;
+@property(nonatomic) size_t packetSize;
+@end
+@implementation GPVMNet
+@end
+
+void *gp_vmnet_open(const char *bridge, unsigned char *mac, int *error) {
+    @autoreleasepool {
+        GPVMNet *owner = [GPVMNet new];
+        owner.queue = dispatch_queue_create("dev.glidepod.vmnet", DISPATCH_QUEUE_SERIAL);
+        owner.event = dispatch_semaphore_create(0);
+        dispatch_semaphore_t ready = dispatch_semaphore_create(0);
+        xpc_object_t desc = xpc_dictionary_create(NULL, NULL, 0);
+        xpc_dictionary_set_uint64(desc, vmnet_operation_mode_key, VMNET_BRIDGED_MODE);
+        xpc_dictionary_set_string(desc, vmnet_shared_interface_name_key, bridge);
+        __block vmnet_return_t result = VMNET_FAILURE;
+        __block struct { unsigned int values[6]; } address = {{0}};
+        owner.interface = vmnet_start_interface(desc, owner.queue, ^(vmnet_return_t status, xpc_object_t params) {
+            result = status;
+            if (status == VMNET_SUCCESS) {
+                const char *value = xpc_dictionary_get_string(params, vmnet_mac_address_key);
+                owner.packetSize = xpc_dictionary_get_uint64(params, vmnet_max_packet_size_key);
+                if (!value || sscanf(value, "%x:%x:%x:%x:%x:%x", &address.values[0], &address.values[1], &address.values[2], &address.values[3], &address.values[4], &address.values[5]) != 6
+                    || owner.packetSize < 1514 || owner.packetSize > 16384) result = VMNET_INVALID_ARGUMENT;
+            }
+            dispatch_semaphore_signal(ready);
+        });
+        if (!owner.interface || dispatch_semaphore_wait(ready, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC)) != 0) {
+            *error = VMNET_FAILURE;
+            // The failed engine exits. Any outstanding callback retains its owner safely.
+            return NULL;
+        }
+        if (result != VMNET_SUCCESS) {
+            *error = result;
+            vmnet_stop_interface(owner.interface, owner.queue, ^(vmnet_return_t status) { (void)status; });
+            return NULL;
+        }
+        for (int i = 0; i < 6; i++) mac[i] = (unsigned char)address.values[i];
+        dispatch_semaphore_t event = owner.event;
+        result = vmnet_interface_set_event_callback(owner.interface, VMNET_INTERFACE_PACKETS_AVAILABLE, owner.queue,
+            ^(interface_event_t mask, xpc_object_t info) { (void)mask; (void)info; dispatch_semaphore_signal(event); });
+        if (result != VMNET_SUCCESS) {
+            *error = result;
+            vmnet_stop_interface(owner.interface, owner.queue, ^(vmnet_return_t status) { (void)status; });
+            return NULL;
+        }
+        *error = 0;
+        return (__bridge_retained void *)owner;
+    }
+}
+void gp_vmnet_wake(void *handle) {
+    GPVMNet *owner = (__bridge GPVMNet *)handle;
+    dispatch_semaphore_signal(owner.event);
+}
+void gp_vmnet_wait(void *handle) {
+    GPVMNet *owner = (__bridge GPVMNet *)handle;
+    dispatch_semaphore_wait(owner.event, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC));
+}
+int gp_vmnet_read(void *handle, unsigned char *bytes, size_t capacity) {
+    GPVMNet *owner = (__bridge GPVMNet *)handle;
+    if (capacity < owner.packetSize) return -1;
+    struct iovec iov = { bytes, capacity };
+    struct vmpktdesc packet = { .vm_pkt_size = capacity, .vm_pkt_iov = &iov, .vm_pkt_iovcnt = 1, .vm_flags = 0 };
+    int count = 1;
+    vmnet_return_t status = vmnet_read(owner.interface, &packet, &count);
+    if (status != VMNET_SUCCESS) return -1;
+    return count ? (int)packet.vm_pkt_size : 0;
+}
+int gp_vmnet_write(void *handle, const unsigned char *bytes, size_t size) {
+    GPVMNet *owner = (__bridge GPVMNet *)handle;
+    if (size > owner.packetSize) return -1;
+    struct iovec iov = { (void *)bytes, size };
+    struct vmpktdesc packet = { .vm_pkt_size = size, .vm_pkt_iov = &iov, .vm_pkt_iovcnt = 1, .vm_flags = 0 };
+    int count = 1;
+    return vmnet_write(owner.interface, &packet, &count) == VMNET_SUCCESS && count == 1 ? 0 : -1;
+}
+void gp_vmnet_close(void *handle) {
+    @autoreleasepool {
+        GPVMNet *owner = (__bridge_transfer GPVMNet *)handle;
+        vmnet_interface_set_event_callback(owner.interface, VMNET_INTERFACE_PACKETS_AVAILABLE, NULL, NULL);
+        dispatch_semaphore_t stopped = dispatch_semaphore_create(0);
+        vmnet_stop_interface(owner.interface, owner.queue, ^(vmnet_return_t result) {
+            (void)result; dispatch_semaphore_signal(stopped);
+        });
+        dispatch_semaphore_wait(stopped, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
+        dispatch_sync(owner.queue, ^{});
+    }
+}
