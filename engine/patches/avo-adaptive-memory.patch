index 0000000..5e4bb23
--- /dev/null
+++ b/engine/hvf/vmm/src/virtio/balloon.rs
@@ -0,0 +1,229 @@
+//! GlidePod virtio balloon and free-page reporting. Only guest-surrendered RAM is replaced.
+use super::{Active, Interrupt, VirtioDevice, queue::Queue};
+use crate::memory::GuestMemory;
+use std::collections::BTreeMap;
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicU32, AtomicU64, Ordering},
+};
+
+static MEMORY: Mutex<Option<std::sync::Weak<GuestMemory>>> = Mutex::new(None);
+static TARGET: AtomicU32 = AtomicU32::new(0);
+static ACTUAL: AtomicU32 = AtomicU32::new(0);
+static RECLAIMED: AtomicU64 = AtomicU64::new(0);
+static FEATURES: AtomicU64 = AtomicU64::new(0);
+static SIGNAL: Mutex<Option<Interrupt>> = Mutex::new(None);
+pub fn target(pages: u32) -> Result<(), String> {
+    let signal = SIGNAL.lock().unwrap();
+    let signal = signal.as_ref().ok_or("balloon driver not active")?;
+    TARGET.store(pages, Ordering::Release);
+    signal.signal_config();
+    Ok(())
+}
+pub fn status() -> String {
+    format!(
+        "{{\"version\":1,\"active\":{},\"reporting\":{},\"target_mib\":{},\"actual_mib\":{},\"reclaimed_bytes\":{}}}",
+        SIGNAL.lock().unwrap().is_some(),
+        FEATURES.load(Ordering::Acquire) & (1 << 5) != 0,
+        TARGET.load(Ordering::Acquire) / 256,
+        ACTUAL.load(Ordering::Acquire) / 256,
+        RECLAIMED.load(Ordering::Acquire)
+    )
+}
+
+// On-demand diagnostic only. mincore inspects backing objects without faulting
+// their contents in; a shared guest/host page is visited once. PAGED_OUT is
+// uncompressed logical size, not the compressor's physical storage. Sampling
+// is concurrent with guest execution and excludes VMM and graphics allocations.
+pub fn residency() -> String {
+    let Some(memory) = MEMORY.lock().unwrap().as_ref().and_then(|m| m.upgrade()) else {
+        return "error balloon driver not active".into();
+    };
+    let len = memory.size() as usize;
+    let mut pages = vec![0i8; len / 16384];
+    let started = std::time::Instant::now();
+    if unsafe {
+        libc::mincore(
+            memory.host_ptr(memory.base(), len).unwrap().cast(),
+            len,
+            pages.as_mut_ptr(),
+        )
+    } != 0
+    {
+        return format!("error mincore {}", std::io::Error::last_os_error());
+    }
+    let resident = pages.iter().filter(|p| **p & 1 != 0).count() * 16384;
+    let paged_out = pages
+        .iter()
+        .filter(|p| **p & 1 == 0 && **p & 0x20 != 0)
+        .count()
+        * 16384;
+    format!(
+        "{{\"version\":1,\"capacity_bytes\":{},\"resident_bytes\":{},\"paged_out_bytes\":{},\"unbacked_bytes\":{},\"scan_ms\":{}}}",
+        len,
+        resident,
+        paged_out,
+        len - resident - paged_out,
+        started.elapsed().as_millis()
+    )
+}
+
+#[derive(Default)]
+pub struct Balloon {
+    active: Option<Active>,
+    // 4 KiB PFNs grouped into complete 64 KiB host extents; partial objects remain intact.
+    inflated: BTreeMap<u64, u16>,
+}
+impl VirtioDevice for Balloon {
+    fn device_type(&self) -> u16 {
+        5
+    }
+    fn features(&self) -> u64 {
+        (1 << 0) | (1 << 2) | (1 << 5)
+    }
+    fn queue_sizes(&self) -> Vec<u16> {
+        vec![128, 128, 128]
+    }
+    fn config(&self) -> Vec<u8> {
+        [
+            TARGET.load(Ordering::Acquire).to_le_bytes(),
+            ACTUAL.load(Ordering::Acquire).to_le_bytes(),
+        ]
+        .concat()
+    }
+    fn write_config(&mut self, offset: usize, data: &[u8]) {
+        if offset == 4 && data.len() == 4 {
+            ACTUAL.store(
+                u32::from_le_bytes(data.try_into().unwrap()),
+                Ordering::Release,
+            );
+        }
+    }
+    fn activate(
+        &mut self,
+        memory: Arc<GuestMemory>,
+        queues: Vec<Queue>,
+        interrupt: Interrupt,
+        features: u64,
+    ) {
+        self.inflated.clear();
+        *MEMORY.lock().unwrap() = Some(Arc::downgrade(&memory));
+        TARGET.store(0, Ordering::Release);
+        ACTUAL.store(0, Ordering::Release);
+        RECLAIMED.store(0, Ordering::Release);
+        FEATURES.store(features, Ordering::Release);
+        *SIGNAL.lock().unwrap() = Some(interrupt.clone());
+        self.active = Some(Active {
+            memory,
+            queues,
+            interrupt,
+        });
+    }
+    fn notify(&mut self, queue: usize) {
+        if !matches!(queue, 0 | 1 | 2) {
+            return;
+        }
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        for _ in 0..128 {
+            let Some(chain) = active.queues[queue].pop(&active.memory) else {
+                break;
+            };
+            if queue == 2 {
+                if FEATURES.load(Ordering::Acquire) & (1 << 5) != 0 {
+                    // Linux retains these free pages until completion. Never reclaim rounded-out ranges.
+                    for d in chain.writable() {
+                        if valid_report(
+                            active.memory.base(),
+                            active.memory.size(),
+                            d.address,
+                            d.len as u64,
+                        ) {
+                            if let Ok(bytes) =
+                                unsafe { active.memory.reclaim(d.address, d.len as usize) }
+                            {
+                                RECLAIMED.fetch_add(bytes as u64, Ordering::Relaxed);
+                            }
+                        }
+                    }
+                }
+            } else if chain.readable_len() <= 4096
+                && let Some(data) = chain.read_all(&active.memory)
+            {
+                if data.len() <= 4096 && data.len() % 4 == 0 {
+                    for raw in data.chunks_exact(4) {
+                        let address = u32::from_le_bytes(raw.try_into().unwrap()) as u64 * 4096;
+                        if active.memory.host_ptr(address, 4096).is_none() {
+                            continue;
+                        }
+                        let block = address & !(65536 - 1);
+                        let page = ((address - block) / 4096) as u16;
+                        if queue == 0 {
+                            let pages = self.inflated.entry(block).or_default();
+                            let was = *pages;
+                            *pages |= 1 << page;
+                            if was != u16::MAX && *pages == u16::MAX {
+                                if let Ok(bytes) = unsafe { active.memory.reclaim(block, 65536) } {
+                                    RECLAIMED.fetch_add(bytes as u64, Ordering::Relaxed);
+                                }
+                            }
+                        } else if let Some(pages) = self.inflated.get_mut(&block) {
+                            *pages &= !(1 << page);
+                            if *pages == 0 {
+                                self.inflated.remove(&block);
+                            }
+                        }
+                    }
+                }
+            }
+            // All host and stage-2 mappings are valid again before guest reuse.
+            active.complete(queue, chain.head, 0);
+        }
+    }
+    fn reset(&mut self) {
+        *SIGNAL.lock().unwrap() = None;
+        *MEMORY.lock().unwrap() = None;
+        TARGET.store(0, Ordering::Release);
+        ACTUAL.store(0, Ordering::Release);
+        FEATURES.store(0, Ordering::Release);
+        self.active = None;
+        self.inflated.clear();
+    }
+}
+fn valid_report(base: u64, size: u64, address: u64, len: u64) -> bool {
+    let block = 65536;
+    len > 0
+        && len <= 64 << 20
+        && address % block == 0
+        && len % block == 0
+        && address >= base
+        && address
+            .checked_add(len)
+            .is_some_and(|end| base.checked_add(size).is_some_and(|limit| end <= limit))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn reports_never_round_into_live_pages_or_escape_ram() {
+        assert!(valid_report(0x80000000, 4 << 30, 0x80010000, 65536));
+        assert!(!valid_report(
+            0x80000000,
+            4 << 30,
+            0x80000000,
+            (64 << 20) + 65536
+        ));
+        assert!(valid_report(0x80000000, 4 << 30, 0x80200000, 2 << 20));
+        assert!(!valid_report(0x80000000, 4 << 30, 0x80201000, 2 << 20));
+        assert!(!valid_report(0x80000000, 4 << 30, 0x80200000, 4096));
+        assert!(!valid_report(0x80000000, 4 << 30, 0x7fe00000, 2 << 20));
+        assert!(!valid_report(
+            0,
+            u64::MAX,
+            u64::MAX - ((2 << 20) - 1),
+            2 << 20
+        ));
+        assert!(!valid_report(0x80000000, 4 << 30, 0x80000000, 0));
+    }
+}
